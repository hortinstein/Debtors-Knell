__pycache__/
*.pyc
scripts/cache/
.claude/

# Calculated per-deck price-history sidecars (scripts/build_price_history.py).
# Rebuilt automatically on webapp startup and after every price-data fetch
# (scripts/fetch_prices.py) -- not checked in.
archive/*/decklist*_price_history.json

# Calculated per-card price history (scripts/build_card_history.py), what the
# card pages and the card modal chart. Same deal: rebuilt on webapp startup
# when missing and after every price fetch, not checked in.
prices/card_history.json.gz

# Local Frozen-Flask output (staticsite/freeze.py). GitHub Actions builds and
# deploys this straight to Pages -- it's never committed.
staticsite/build/
